# Environment configuration for the Trading Intelligence System.
# Copy this file to .env and fill in real values. Never commit .env.
#
# Two provider integrations are implemented and active: FRED (macro
# data) and Alpha Vantage (technical price candles and news) — see
# README.md's Provider Abstraction section. Sentiment, and the Data
# Controller's own generic marketData domain, have no chosen provider
# yet; nothing is assumed or invented ahead of that.
#
# Three environments are recognized (see README.md's Environments
# section for detail):
#   development — local iteration; real FRED/Alpha Vantage calls only
#                 if the credentials below are set, otherwise
#                 synthetic/caller-supplied data
#   test        — `npm test`; synthetic/mocked in-memory fixtures
#                 only, never requires real credentials
#   production   — real provider adapters, real credentials
# No real credentials exist in this repo in any environment today —
# this file contains no real values.

# Port the HTTP API listens on. Optional.
PORT=3000

# Network interface the HTTP API binds to. Optional; defaults to
# 127.0.0.1 (loopback only) so a server holding real provider
# credentials is never reachable from the network by accident.
# CONTAINER/CLOUD PLATFORMS (Railway, Docker, Fly, ...) REQUIRE
# HOST=0.0.0.0 — without it the platform's health check can never
# reach the process. Read ONLY in server.js.
HOST=127.0.0.1

# Environment name: development | test | production.
NODE_ENV=development

# --- Provider credentials -------------------------------------------
# FRED (Federal Reserve Economic Data) — macro data for the Macro
# Agent. Read ONLY in providers/fredMacroLiveSource.js.
FRED_API_KEY=

# Alpha Vantage — technical price candles (Technical Agent) and news
# (News Agent). Read ONLY in providers/alphaVantageMarketLiveSource.js
# and providers/alphaVantageNewsLiveSource.js.
ALPHAVANTAGE_API_KEY=

# Sentiment, and the Data Controller's own generic marketData domain,
# have no chosen provider yet — no credential name exists for either
# because no adapter that would consume one has been built.

# Anthropic (Claude) — the optional, isolated reasoning/annotation
# layer (see LLM_REASONING_LAYER_DESIGN.md). Disabled by default; only
# used for a given request when the caller explicitly sets
# options.llm.enabled === true. Read ONLY in
# llm/anthropicLiveSource.js. Never influences deterministic decisions
# (risk_decision/decision_status/final_assessment) — see
# app.js/llm/reasoningService.js. Supply the real secret only via the
# environment (this file, .env, or your deployment platform's secret
# store) — never hardcode it and never commit .env.
ANTHROPIC_API_KEY=

# --- HTTP API security (Step 105) -----------------------------------
# Shared bearer secret required on every POST /api/intelligence and
# POST /api/portfolio-intelligence request (Authorization: Bearer
# <value>). Read ONLY in server.js. If left unset, every request to
# either endpoint is rejected with 401 (fails closed, never opens the
# API by accident) — GET /health never requires this.
API_AUTH_TOKEN=

# Basic per-client-IP rate limiting for every route except /health.
# Both optional; sane defaults apply if omitted (60000ms / 30 requests
# — 30 requests per IP per minute). Read ONLY in server.js.
RATE_LIMIT_WINDOW_MS=
RATE_LIMIT_MAX_REQUESTS=

# Whether to believe the X-Forwarded-For header when identifying a
# client for rate limiting. OFF unless set to 1/true/yes/on.
#
# Why it defaults to off: X-Forwarded-For is caller-suppliable. When it
# was always trusted, a client could send a different fake value on
# every request and land in a fresh rate-limit bucket each time, which
# made the limiter useless. With this off, the header is ignored and
# the real socket address is counted.
#
# Turn it ON only when a proxy in front of this process OVERWRITES the
# header (Railway, nginx, a cloud load balancer). Turning it on without
# such a proxy re-opens the bypass. Leaving it off behind a proxy is
# safe but blunt: all traffic shares the proxy's single IP bucket.
# Read ONLY in server.js.
TRUST_PROXY=

# Where completed run records are appended (data/runStore.js). Optional;
# defaults to data/runs.jsonl. Useful for pointing run history at a
# mounted volume in deployment. Read ONLY in server.js.
RUN_STORE_FILE=
